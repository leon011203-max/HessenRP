# Discord Bot Token
DISCORD_TOKEN=your_bot_token_here

# Discord Client ID
CLIENT_ID=your_client_id_here

# Discord Guild ID (Server ID)
GUILD_ID=your_guild_id_here

# Admin User IDs (kommagetrennt)
ADMIN_IDS=123456789012345678,987654321098765432

# Verify Rolle ID(s) - User erhalten diese Rolle(n) nach Verifizierung
# Mehrere Rollen möglich (kommagetrennt wie bei ADMIN_IDS)
VERIFY_ROLE_ID=1234567890123456789
# Beispiel für mehrere Rollen:
# VERIFY_ROLE_ID=1234567890123456789,9876543210987654321
